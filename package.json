{
  "name": "sci-pre-submission-review",
  "version": "5.0.0",
  "description": "临床 SCI 稿件投稿前预审质控 Web 系统",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node src/server.js",
    "start": "NODE_ENV=production node src/server.js",
    "check": "node --check src/server.js",
    "web-review:browser": "node scripts/web_review_browser_runner.mjs",
    "service:install": "scripts/service/install-launchd.sh",
    "service:uninstall": "scripts/service/uninstall-launchd.sh",
    "service:status": "scripts/service/status-launchd.sh",
    "service:logs": "tail -n 120 storage/logs/intron-tools.out.log storage/logs/intron-tools.err.log"
  },
  "dependencies": {
    "docx": "^9.5.1",
    "express": "^5.1.0",
    "mammoth": "^1.10.0",
    "multer": "^2.0.2",
    "playwright-core": "^1.60.0",
    "word-extractor": "^1.0.4"
  },
  "engines": {
    "node": ">=20"
  }
}
